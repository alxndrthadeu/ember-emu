    },
    "Toque para compartilhar um relatório, por exemplo ao relatar um problema no GitHub do Ember. Nada sai do iPhone sem você mandar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to share a report, for example when reporting a problem on Ember's GitHub. Nothing leaves the iPhone unless you send it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para compartir un informe, por ejemplo al reportar un problema en el GitHub de Ember. Nada sale del iPhone sin que lo envíes."
          }
        }
      }
    },
