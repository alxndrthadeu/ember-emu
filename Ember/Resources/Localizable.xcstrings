      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "RPG Maker XP, VX and VX Ace games: .zip, .rar, .7z, self-extracting .exe or the game folder"
          }
        },
        "es" : {
          "stringUnit" : {
