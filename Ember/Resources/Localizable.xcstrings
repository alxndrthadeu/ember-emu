            "value" : "Yesterday"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayer"
          }
        }
      }
    },
    "Opções" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Options"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opciones"
          }
        }
      }
    },
    "Os arquivos do jogo saem do iPhone. Os saves ficam guardados no Ember: importe o jogo de novo e eles voltam." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game's files leave the iPhone. Saves stay in Ember: import the game again and they come back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los archivos del juego salen del iPhone. Las partidas quedan guardadas en Ember: importa el juego de nuevo y vuelven."
          }
        }
      }
    },
    "Os jogos e os saves não mudam." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Games and saves don't change."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los juegos y las partidas no cambian."
          }
        }
      }
    },
    "Os perfis prontos não mudam. Duplique para criar o seu a partir deste." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Built-in profiles don't change. Duplicate this one to make your own."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los perfiles predefinidos no cambian. Duplica este para crear el tuyo."
          }
        }
      }
    },
    "Ou solte arquivos aqui" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Or drop files here"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O suelta archivos aquí"
          }
        }
      }
    },
    "Outros caminhos" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Other ways"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otras formas"
          }
        }
      }
    },
    "Padrão" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estándar"
          }
        }
      }
    },
    "Padrão serve para Pokémon Essentials v19 ou mais novo e jogos em Ruby 3. Clássico serve para jogos antigos: Start abre o menu e segurar Select faz correr. Cada jogo usa um deles automaticamente, e você pode trocar no painel do jogo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Standard fits Pokémon Essentials v19 or newer and Ruby 3 games. Classic fits older games: Start opens the menu and holding Select runs. Each game uses one of them automatically, and you can change it in the game's panel."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estándar sirve para Pokémon Essentials v19 o más nuevo y juegos en Ruby 3. Clásico sirve para juegos antiguos: Start abre el menú y mantener Select hace correr. Cada juego usa uno automáticamente, y puedes cambiarlo en el panel del juego."
          }
        }
      }
    },
    "Para ouvir sua música enquanto joga, desligue o som do jogo ou deixe tocar junto. Assim o Spotify, o Apple Music ou um podcast continuam tocando. Nesse modo, a chave de silêncio do iPhone também silencia o jogo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To listen to your music while playing, turn the game sound off or let it play alongside. Spotify, Apple Music or a podcast then keep playing. In that mode, the iPhone's silent switch also silences the game."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para escuchar tu música mientras juegas, apaga el sonido del juego o déjalo sonar junto. Así Spotify, Apple Music o un pódcast siguen sonando. En ese modo, el interruptor de silencio del iPhone también silencia el juego."
          }
        }
      }
    },
    "Para trazer o jogo de volta, pare o espelhamento na Central de Controle." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To bring the game back, stop mirroring in Control Center."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para traer el juego de vuelta, detén la duplicación en el Centro de control."
          }
        }
      }
    },
