    "Nítido" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sharp"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nítido"
          }
        }
      }
    },
    "No app, escolha o iPhone e abra Arquivos. Selecione o Ember." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the app, choose the iPhone and open Files. Select Ember."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la app, elige el iPhone y abre Archivos. Selecciona Ember."
          }
        }
      }
    },
    "No canto: botões que já apertam a tecla" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the corner: buttons that already press the key"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En la esquina: botones que ya pulsan la tecla"
          }
        }
      }
    },
    "No Finder, escolha o iPhone na barra lateral e abra a aba Arquivos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In the Finder, choose the iPhone in the sidebar and open the Files tab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el Finder, elige el iPhone en la barra lateral y abre la pestaña Archivos."
          }
        }
      }
    },
    "No iCloud" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In iCloud"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En iCloud"
          }
        }
      }
    },
    "No mapa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On the map"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el mapa"
          }
        }
      }
    },
    "No PC, os saves ficam na pasta do jogo (Save1.rxdata, Save01.rvdata2) ou, nos fangames de Pokémon, em %%APPDATA%%\\%@ (Game.rxdata). O Ember usa os mesmos arquivos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "On a PC, saves live in the game folder (Save1.rxdata, Save01.rvdata2) or, for Pokémon fan games, in %%APPDATA%%\\%@ (Game.rxdata). Ember uses the same files."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el PC, las partidas están en la carpeta del juego (Save1.rxdata, Save01.rvdata2) o, en los fangames de Pokémon, en %%APPDATA%%\\%@ (Game.rxdata). Ember usa los mismos archivos."
          }
        }
      }
    },
    "No Safari, no Arquivos ou num app de mensagens também dá: toque no arquivo, depois em Compartilhar e em Ember." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "From Safari, Files or a messaging app works too: tap the file, then Share, then Ember."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Desde Safari, Archivos o una app de mensajes también: toca el archivo, luego Compartir y Ember."
          }
        }
      }
    },
    "Nome" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Name"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre"
          }
        }
      }
    },
    "Nome do perfil" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profile name"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre del perfil"
          }
        }
      }
    },
    "normal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "normal"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "normal"
          }
        }
      }
    },
    "Nos jogos novos abre o menu; nos antigos, segurar corre (Shift, Input::A)" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens the menu in newer games; in older ones, hold to run (Shift, Input::A)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En los juegos nuevos abre el menú; en los antiguos, mantener para correr (Shift, Input::A)"
          }
        }
      }
    },
    "Novo perfil" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New Profile"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nuevo perfil"
          }
        }
      }
    },
    "O app fechou sozinho" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app closed on its own"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se cerró sola"
          }
        }
      }
    },
    "O app travou" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app froze"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app se colgó"
          }
        }
      }
    },
    "O arquivo de “%@” não está mais no iCloud Drive." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file for “%@” is no longer in iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo de “%@” ya no está en iCloud Drive."
          }
        }
      }
    },
    "O arquivo está protegido por senha. Extraia no computador e importe a pasta ou um .zip." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The archive is password protected. Extract it on a computer and import the folder or a .zip."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo está protegido con contraseña. Extráelo en el ordenador e importa la carpeta o un .zip."
          }
        }
      }
    },
    "O arquivo sai do jogo e fica guardado em Backups, no app Arquivos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The file leaves the game and is kept in Backups, in the Files app."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo sale del juego y se guarda en Backups, en la app Archivos."
          }
        }
      }
    },
    "O avanço rápido é a velocidade dos botões de acelerar das skins. No menu da engrenagem você escolhe a velocidade na hora." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast forward is the speed of the skins' speed-up buttons. In the gear menu you pick the speed on the spot."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El avance rápido es la velocidad de los botones de acelerar de las skins. En el menú del engranaje eliges la velocidad al momento."
          }
        }
      }
    },
    "O botão não faz nada" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The button does nothing"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El botón no hace nada"
          }
        }
      }
    },
    "O direcional e o analógico apertam estas teclas. A maioria dos jogos anda com as setas." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The D-pad and the stick press these keys. Most games walk with the arrows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cruceta y el stick pulsan estas teclas. La mayoría de los juegos caminan con las flechas."
          }
        }
      }
    },
    "O download de “%@” parou. Confira a internet e toque no jogo de novo; o que já baixou continua." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The download of “%@” stopped. Check the internet and tap the game again; what was downloaded stays."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La descarga de “%@” se detuvo. Revisa internet y toca el juego otra vez; lo que ya se descargó se mantiene."
          }
        }
      }
    },
    "O Ember abre um jogo por vez. Deslize de baixo para cima, feche o Ember no seletor de apps e abra de novo. Seus saves estão guardados." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember opens one game at a time. Swipe up from the bottom, close Ember in the app switcher and open it again. Your saves are safe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember abre un juego a la vez. Desliza desde abajo, cierra Ember en el selector de apps y ábrelo de nuevo. Tus partidas están a salvo."
          }
        }
      }
    },
    "O Ember contém uma versão modificada do mkxp-z-apple-mobile (patches em engine-patches/ no código-fonte do Ember), baseado no mkxp-z e no mkxp." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember contains a modified version of mkxp-z-apple-mobile (patches in engine-patches/ in Ember’s source code), based on mkxp-z and mkxp."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember contiene una versión modificada de mkxp-z-apple-mobile (parches en engine-patches/ del código fuente de Ember), basado en mkxp-z y mkxp."
          }
        }
      }
    },
    "O Ember encontra o jogo mesmo dentro de subpastas. Se quiser, ele manda o arquivo compactado para a lixeira depois de importar, para liberar espaço (Ajustes › Importação)." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember finds the game even inside subfolders. If you like, it moves the archive to the trash after importing, to free up space (Settings › Import)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember encuentra el juego incluso dentro de subcarpetas. Si quieres, envía el archivo comprimido a la papelera después de importar, para liberar espacio (Ajustes › Importación)."
          }
        }
      }
    },
    "O Ember volta a usar o teclado do iPhone" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember goes back to the iPhone keyboard"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ember vuelve a usar el teclado del iPhone"
          }
        }
      }
    },
    "O envio parou. Confira se o Wi-Fi do Ember continua ligado e tente de novo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The upload stopped. Check that Ember’s Wi-Fi is still on and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío se detuvo. Comprueba que el Wi-Fi de Ember siga activado e inténtalo de nuevo."
          }
        }
      }
    },
    "O envio parou. Os jogos que chegaram inteiros ficaram no Mac." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The transfer stopped. The games that arrived whole stayed on the Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El envío se detuvo. Los juegos que llegaron completos se quedaron en el Mac."
          }
        }
      }
    },
    "O iCloud não está disponível. Entre na sua conta em Ajustes do iPhone e ligue o iCloud Drive." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud is not available. Sign in to your account in the iPhone’s Settings and turn on iCloud Drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud no está disponible. Inicia sesión en Ajustes del iPhone y activa iCloud Drive."
          }
        }
      }
    },
    "O iOS manda ao Ember, uma vez por dia, um resumo de desempenho e o que deu errado: travamentos, aquecimento, uso alto de CPU. Ficam só neste iPhone." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Once a day iOS sends Ember a performance summary and what went wrong: freezes, heat, high CPU use. They stay on this iPhone only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una vez al día iOS envía a Ember un resumen de rendimiento y lo que salió mal: bloqueos, calor, uso alto de CPU. Se quedan solo en este iPhone."
          }
        }
      }
    },
    "O iPhone mandou um arquivo inesperado." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPhone sent an unexpected file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone envió un archivo inesperado."
          }
        }
      }
    },
    "O iPhone se desconectou antes de terminar. Os jogos que chegaram inteiros ficaram." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPhone disconnected before finishing. The games that arrived whole stayed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone se desconectó antes de terminar. Los juegos que llegaron completos se quedaron."
          }
        }
      }
    },
    "O iPhone vira o controle: botões grandes, sempre deitado, com o menu do jogo (engrenagem) e o teclado. Os botões seguem os controles daquele jogo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The iPhone becomes the controller: big buttons, always in landscape, with the game menu (gear) and the keyboard. The buttons follow that game's controls."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone se convierte en el control: botones grandes, siempre en horizontal, con el menú del juego (engranaje) y el teclado. Los botones siguen los controles de ese juego."
          }
        }
      }
    },
    "O iPhone virou o controle" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your iPhone is now the controller"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El iPhone ahora es el mando"
          }
        }
      }
    },
    "O jogo aparece no navegador da TV ou do computador, e o iPhone vira o controle." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game shows in the TV or computer browser, and your iPhone becomes the controller."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego aparece en el navegador de la TV o del ordenador, y el iPhone pasa a ser el mando."
          }
        }
      }
    },
    "O jogo começa com este perfil. O que você mudar abaixo vale só para este jogo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game starts from this profile. What you change below applies to this game only."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego empieza con este perfil. Lo que cambies abajo vale solo para este juego."
          }
        }
      }
    },
    "O jogo encontrou um erro" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game ran into an error"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego encontró un error"
          }
        }
      }
    },
    "O jogo não foi encontrado" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game was not found"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encontró el juego"
          }
        }
      }
    },
    "O jogo não respondeu. Tente de novo andando pelo mapa" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game didn't answer. Try again while walking around the map"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego no respondió. Inténtalo de nuevo caminando por el mapa"
          }
        }
      }
    },
    "O jogo passa a usar o perfil novo, e outros jogos também podem usá-lo." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game switches to the new profile, and other games can use it too."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego pasa a usar el nuevo perfil, y otros juegos también pueden usarlo."
          }
        }
      }
    },
    "O jogo sai do iCloud de vez. Os saves que ficaram no iPhone continuam." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game leaves iCloud for good. The saves kept on the iPhone stay."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego sale de iCloud para siempre. Las partidas que quedaron en el iPhone se mantienen."
          }
        }
      }
    },
    "O jogo vai para o iCloud Drive (pasta Ember) e sai do iPhone, liberando %@. Saves, estados, capa e histórico ficam. Para jogar de novo, toque nele na estante." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game moves to iCloud Drive (Ember folder) and leaves the iPhone, freeing %@. Saves, states, cover and history stay. To play again, tap it on the shelf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego pasa a iCloud Drive (carpeta Ember) y sale del iPhone, liberando %@. Partidas, estados, portada e historial se quedan. Para volver a jugar, tócalo en la estantería."
          }
        }
      }
    },
    "O jogo vai usar o próprio teclado na próxima vez que abrir" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game will use its own keyboard the next time it opens"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego usará su propio teclado la próxima vez que se abra"
          }
        }
      }
    },
    "O jogo volta à tela de título. O que não foi salvo se perde." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The game goes back to its title screen. Anything not saved is lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El juego vuelve a la pantalla de título. Lo que no se guardó se pierde."
          }
        }
      }
    },
    "O Mac não respondeu." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac did not answer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac no respondió."
          }
        }
      }
    },
    "O Mac recusou o envio" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac declined the transfer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac rechazó el envío"
          }
        }
      }
    },
    "O Mac saiu do alcance ou o jogo fechou." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Mac went out of range or the game closed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Mac quedó fuera de alcance o el juego se cerró."
          }
        }
      }
    },
    "O mesmo app, baixado da App Store no Mac. Não precisa estar no mesmo Wi-Fi: o iPhone acha o Mac direto, como no AirDrop." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The same app, downloaded from the App Store on the Mac. It does not need to be on the same Wi-Fi: the iPhone finds the Mac directly, as with AirDrop."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La misma app, descargada de la App Store en el Mac. No hace falta estar en la misma red Wi-Fi: el iPhone encuentra el Mac directamente, como con AirDrop."
          }
        }
      }
    },
    "O perfil aparece em Ajustes › Perfis de controle e pode ser usado em outros jogos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profile shows up in Settings › Control profiles and can be used in other games."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil aparece en Ajustes › Perfiles de control y se puede usar en otros juegos."
          }
        }
      }
    },
    "O perfil sai da lista. Isso não pode ser desfeito." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The profile leaves the list. This can't be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El perfil sale de la lista. No se puede deshacer."
          }
        }
      }
    },
    "O progresso que não foi salvo no jogo será perdido." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Progress not saved in the game will be lost."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se perderá el progreso que no se haya guardado en el juego."
          }
        }
      }
    },
    "O que dá para importar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you can import"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué se puede importar"
          }
        }
      }
    },
    "O save ainda não chegou. Abrindo com o que está aqui." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The save has not arrived yet. Opening with what is here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La partida todavía no llegó. Abriendo con lo que hay aquí."
          }
        }
      }
    },
    "O Windows não copia pastas por esse caminho: compacte a pasta do jogo num .zip antes, ou use o Wi-Fi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows doesn’t copy folders this way: zip the game folder first, or use Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows no copia carpetas por esta vía: comprime la carpeta del juego en un .zip antes, o usa la Wi-Fi."
          }
        }
      }
    },
    "Ocultar o Ember" : {
      "localizations" : {
