    "%@ teve saves mudados aqui e em outro aparelho. Ficou o mais recente; o outro está guardado em Backups." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ had saves changed here and on another device. The newest one stays; the other is kept in Backups."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ tuvo partidas cambiadas aquí y en otro dispositivo. Se queda la más reciente; la otra está guardada en Backups."
          }
        }
      }
    },
