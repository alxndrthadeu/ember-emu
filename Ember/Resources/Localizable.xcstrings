      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No reports"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ningún informe"
          }
        }
      }
    },
    "Nenhum save ainda" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saves yet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay partidas"
          }
        }
      }
    },
    "Nenhuma partida ainda" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No Sessions Yet"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay partidas"
          }
        }
