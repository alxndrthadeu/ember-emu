    "Muda só o nome na biblioteca. A pasta e os saves continuam iguais." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Only changes the name in the library. The folder and saves stay the same."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo cambia el nombre en la biblioteca. La carpeta y las partidas siguen igual."
          }
        }
      }
    },
    "Muita escrita no disco" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Too much disk writing"
          }
        },
        "es" : {
          "stringUnit" : {
