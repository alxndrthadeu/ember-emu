    "Nenhum save ainda. Para continuar de onde parou em outro aparelho, importe os arquivos do jogo (.rxdata, .rvdata ou .rvdata2) ou um .zip deles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saves yet. To pick up where you left off on another device, import the game’s files (.rxdata, .rvdata or .rvdata2) or a .zip of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay partidas. Para seguir donde lo dejaste en otro dispositivo, importa los archivos del juego (.rxdata, .rvdata o .rvdata2) o un .zip con ellos."
          }
        }
      }
    },
    "Nenhum save ainda. Para continuar de onde parou em outro aparelho, use Importar saves com os arquivos do jogo (.rxdata, .rvdata ou .rvdata2) ou um .zip deles." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No saves yet. To pick up where you left off on another device, use Import Saves with the game's files (.rxdata, .rvdata or .rvdata2) or a .zip of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía no hay partidas. Para seguir donde lo dejaste en otro dispositivo, usa Importar partidas con los archivos del juego (.rxdata, .rvdata o .rvdata2) o un .zip con ellos."
          }
        }
      }
    },
    "Nenhuma partida ainda" : {
      "localizations" : {
