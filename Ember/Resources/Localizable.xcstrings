      }
    },
    "O que dá para importar" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "What you can import"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qué se puede importar"
          }
        }
      }
    },
    "O som continua no iPhone. Num computador, clique na imagem para tela cheia." : {
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sound stays on the iPhone. On a computer, click the picture for full screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El sonido sigue en el iPhone. En un ordenador, haz clic en la imagen para pantalla completa."
          }
        }
      }
    },
    "O Windows não copia pastas por esse caminho: compacte a pasta do jogo num .zip antes, ou use o Wi-Fi." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows doesn’t copy folders this way: zip the game folder first, or use Wi-Fi."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Windows no copia carpetas por esta vía: comprime la carpeta del juego en un .zip antes, o usa la Wi-Fi."
          }
        }
      }
    },
    "OK" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        },
        "es" : {
