    "Salve dentro do jogo e ele aparece aqui. Para continuar de outro aparelho, importe os arquivos (.rxdata, .rvdata ou .rvdata2) ou um .zip deles." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Save inside the game and it shows up here. To continue from another device, import the files (.rxdata, .rvdata or .rvdata2) or a .zip of them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda dentro del juego y aparecerá aquí. Para continuar desde otro dispositivo, importa los archivos (.rxdata, .rvdata o .rvdata2) o un .zip con ellos."
          }
        }
      }
    },
