# App Store Connect API key (Users and Access › Integrations › App Store
# Connect API › Team Keys, role "App Manager"). Copy this file to
# fastlane/.env (ignored by git) and fill it in. Keep the .p8 outside
# the repository.
EMBER_ASC_KEY_ID=
EMBER_ASC_ISSUER_ID=
EMBER_ASC_KEY_PATH=~/.appstoreconnect/AuthKey_XXXXXXXXXX.p8
