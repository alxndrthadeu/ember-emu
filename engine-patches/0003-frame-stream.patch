@@ -1250,8 +1250,34 @@ struct GraphicsPrivate {
         fpsLimiter.resetFrameAdjust();
     }
 
+    /* Frame stream for a TV or computer browser (Ember patch 0003):
+     * the presented frame, at the game's own resolution, at most 30
+     * times a second, and only while the host asks for it. */
+    uint64_t lastStreamTicks = 0;
+
+    void streamFrame(TEXFBO &presented) {
+        if (!mkxp_isFrameStreamEnabled())
+            return;
+        uint64_t now = SDL_GetTicks64();
+        if (now - lastStreamTicks < 33)
+            return;
+        lastStreamTicks = now;
+
+        int w = presented.width;
+        int h = presented.height;
+        if (w <= 0 || h <= 0)
+            return;
+        FBO::ID prevFBO = FBO::boundFramebufferID;
+        FBO::bind(presented.fbo);
+        std::vector<uint8_t> pixels(w * h * 4);
+        gl.ReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+        FBO::bind(prevFBO);
+        mkxp_setStreamFrame(pixels.data(), w, h);
+    }
+
     /* Call right after every swap. */
     void framePresented(TEXFBO &presented) {
+        streamFrame(presented);
         checkPause(presented);
         keepPresentedFrame(presented);
     }
