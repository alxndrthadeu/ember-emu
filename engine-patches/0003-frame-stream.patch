+/* Frame stream (Ember patch 0003). */
+static std::atomic<bool> s_streamEnabled{false};
+static std::mutex s_streamMutex;
+static std::vector<unsigned char> s_streamData;
+static int s_streamWidth = 0, s_streamHeight = 0;
+static unsigned int s_streamSequence = 0;
+
+void mkxp_setFrameStreamEnabled(bool enabled) {
+    s_streamEnabled.store(enabled, std::memory_order_release);
+    if (!enabled) {
+        std::lock_guard<std::mutex> lock(s_streamMutex);
+        s_streamData.clear();
+        s_streamData.shrink_to_fit();
+    }
+}
+
+bool mkxp_isFrameStreamEnabled(void) {
+    return s_streamEnabled.load(std::memory_order_acquire);
+}
+
+void mkxp_setStreamFrame(const unsigned char *data, int width, int height) {
+    std::lock_guard<std::mutex> lock(s_streamMutex);
+    size_t size = (size_t)width * height * 4;
+    s_streamData.assign(data, data + size);
+    s_streamWidth = width;
+    s_streamHeight = height;
+    if (++s_streamSequence == 0) s_streamSequence = 1;
+}
+
+bool mkxp_copyStreamFrame(unsigned char *dest, int destSize, int *width, int *height,
+                          unsigned int *sequence) {
+    std::lock_guard<std::mutex> lock(s_streamMutex);
+    if (s_streamData.empty()) return false;
+    if (sequence && *sequence == s_streamSequence) return false;
+    int size = (int)s_streamData.size();
+    if (destSize < size) {
+        if (width) *width = s_streamWidth;
+        if (height) *height = s_streamHeight;
+        return false;
+    }
+    memcpy(dest, s_streamData.data(), size);
+    if (width) *width = s_streamWidth;
+    if (height) *height = s_streamHeight;
+    if (sequence) *sequence = s_streamSequence;
+    return true;
+}
